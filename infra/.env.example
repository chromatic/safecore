# Copy to .env, chmod 600, and replace ALL CHANGE_ME values.
# Percent-encode URL-special characters in RPC passwords.
PEP_DAEMON_URL=http://safecore:CHANGE_ME@host.docker.internal:33873/
WHT_DAEMON_URL=http://safecore:CHANGE_ME@host.docker.internal:33665/
# One public CA-issued certificate for the Electrum hostname, not a private key in Git.
TLS_CERT_DIR=./certs
PEP_WSS_PORT=50004
WHT_WSS_PORT=50005
